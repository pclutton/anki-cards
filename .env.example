ANTHROPIC_API_KEY=sk-ant-...

# Optional — most people do not need this.
# Only needed if you copy notes OUT of your Obsidian vault before running the
# script: there is then no vault above the note for its embedded images to be
# found in, and your diagrams would go missing. If you point the script at
# notes inside the vault, leave this alone.
# Do NOT put the path in quotes — a Windows path like C:\temp gets mangled.
# OBSIDIAN_VAULT=C:\Users\you\Documents\MyVault
