ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed if you copy notes OUT of your Obsidian vault before
# running the script — then there is no vault above the note for embedded
# images to be found in, and your diagrams would go missing.
# Leave it blank if you point the script at notes inside the vault.
# OBSIDIAN_VAULT=C:\Users\you\Documents\MyVault
