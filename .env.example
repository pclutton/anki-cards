ANTHROPIC_API_KEY=sk-ant-...

# Where your Obsidian vault lives. Set this if you drag notes into
# Source Material/ — it is how the script finds the diagrams your notes refer
# to. Without it the cards are still made, but every diagram goes missing.
# Not needed if you always point the script at notes inside the vault.
# Do NOT put the path in quotes — a Windows path like C:\temp gets mangled.
OBSIDIAN_VAULT=
